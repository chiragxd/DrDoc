{
  "name": "drdoc",
  "private": true,
  "version": "1.0.0",
  "description": "DrDoc (Doctor Document): convert, edit and organize PDFs and documents entirely in your browser.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
