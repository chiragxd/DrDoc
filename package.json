    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "mupdf": "^1.28.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "sortablejs": "^1.15.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.3.0",
    "@types/sortablejs": "^1.15.9",
    "@types/turndown": "^5.0.6",
